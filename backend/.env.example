DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Generate a unique value for production; never commit .env.
DJANGO_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHARED_WORKSPACE_EMAIL=workspace@unbound.org
SITE_BASE_URL=http://localhost:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production additionally requires DATABASE_URL, HTTPS origins and trusted proxy configuration.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_TRUST_PROXY_HEADERS=true
